# NetPulse Capture Engine Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=netpulse
PG_USER=postgres
PG_PASSWORD=postgres

API_BASE_URL=http://localhost:3001
DEMO_MODE=true
DEMO_PACKET_RATE=30
CAPTURE_INTERFACE=Wi-Fi
BPF_FILTER=tcp or udp or icmp
FLUSH_INTERVAL=5
BATCH_SIZE=100

BANDWIDTH_SPIKE_FACTOR=2.0
PORT_SCAN_THRESHOLD=20
FLOOD_THRESHOLD=500
LOG_LEVEL=INFO
